# Copy to backend.tf and replace the bucket name after creating it securely.
# The bucket must have versioning, encryption and public access blocking enabled.
terraform {
  backend "s3" {
    bucket       = "REPLACE_WITH_UNIQUE_STATE_BUCKET"
    key          = "three-tier-platform/dev/terraform.tfstate"
    region       = "ap-south-1"
    encrypt      = true
    use_lockfile = true
  }
}
